{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src/Carandev.WhatsApp.Sdk",
          "files": [
            "Carandev.WhatsApp.Sdk.csproj"
          ]
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net9.0"
      },
      "namespaceLayout": "nested",
      "memberLayout": "separatePages"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**",
          "obj/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "Carandev.WhatsApp.Sdk",
      "_appTitle": "Carandev.WhatsApp.Sdk",
      "_appFooter": "Carandev.WhatsApp.Sdk \u2014 MIT licensed. Not affiliated with Meta.",
      "_enableSearch": true,
      "_disableContribution": true,
      "pdf": false
    }
  }
}
