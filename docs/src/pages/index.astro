---
import { Code } from 'astro:components'
import Base from '../layouts/Base.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Sketch from '../components/Sketch.astro'
import { nugetUrl, repoUrl, url } from '../lib/paths'

const sample = `builder.Services.AddWhatsAppCloudApi(builder.Configuration);

var messages = host.Services.GetRequiredService<IWhatsAppMessagesClient>();

var result = await messages.SendTextAsync("15551234567", "Hello from .NET!");

Console.WriteLine(result.IsSuccess
    ? $"Sent {result.Value!.MessageId}"
    : $"Rejected: {result.Error!.Message}");`

const features = [
  { tone: 'lavender', title: 'Every message type', text: 'Text, media, location, contacts, templates, reply buttons, lists, and CTA URLs, each with a typed method.', href: 'guides/sending-messages/' },
  { tone: 'mint', title: 'Webhooks on any host', text: 'Handshake, HMAC signature validation, parsing, and dispatch. Minimal APIs, controllers, Functions, or Lambda.', href: 'guides/webhooks/' },
  { tone: 'cream', title: 'Retries built in', text: 'Exponential backoff with jitter that honors Retry-After, for 5xx, rate limits, and transient Graph errors.', href: 'guides/errors-and-resilience/' },
  { tone: 'rose', title: 'Errors you can reason about', text: 'Rejected requests come back as Result<T>; only exhausted transient failures throw WhatsAppException.', href: 'guides/errors-and-resilience/' },
  { tone: 'sky', title: 'Templates and media', text: 'Create and manage templates, upload files with size checks, and download inbound media.', href: 'guides/templates/' },
  { tone: 'lavender', title: 'Fully documented', text: 'Every public member carries XML docs, rendered here as a browsable API reference.', href: 'api/' }
]
---

<Base description='A .NET SDK for the WhatsApp Cloud API: typed clients, webhooks on any host, and built-in retries.' title='Carandev.WhatsApp.Sdk'>
  <Header section='home' />
  <main>
    <section class='hero container'>
      <div class='hero__copy' data-reveal>
        <p class='eyebrow'>WhatsApp Cloud API for .NET</p>
        <h1 class='hero__title'>
          Send and receive WhatsApp messages with{' '}
          <span class='hero__mark'><span class='highlight highlight--lavender'>typed, tested</span><Sketch class='hero__underline' shape='underline' /></span>{' '}
          .NET clients.
        </h1>
        <p class='hero__lead'>
          One package for messages, templates, media, phone numbers, and webhooks, with retries and structured errors already wired in.
        </p>
        <div class='hero__actions'>
          <a class='btn btn--primary' href={url('guides/getting-started/')}>
            Get started
            <svg aria-hidden='true' fill='none' height='18' stroke='currentColor' stroke-linecap='round' stroke-width='2.2' viewBox='0 0 24 24' width='18'><path d='M5 12h14M13 6l6 6-6 6' /></svg>
          </a>
          <a class='btn btn--outline' href={url('api/')}>API reference</a>
          <a class='btn btn--lavender' href={repoUrl} rel='noopener'>GitHub</a>
        </div>
      </div>

      <div class='hero__card' data-reveal style='--delay: 0.15s'>
        <span class='tape' style='left: 42%; --tape-rotate: -4deg' />
        <p class='hero__card-label hand'>Install</p>
        <div class='code-block install'><pre><code>dotnet add package Carandev.WhatsApp.Sdk</code></pre></div>
        <p class='hero__card-label hand'>Send</p>
        <div class='code-block'><Code code={sample} defaultColor={false} lang='csharp' wrap themes={{ light: 'vitesse-light', dark: 'vitesse-dark' }} /></div>
        <div class='hero__chips'>
          <span class='chip'>net8.0</span>
          <span class='chip'>net9.0</span>
          <span class='chip'>MIT</span>
          <a class='chip' href={nugetUrl} rel='noopener'>NuGet</a>
        </div>
      </div>
    </section>

    <section class='features container'>
      <p class='eyebrow' data-reveal>What's inside</p>
      <h2 class='section-title' data-reveal>Everything the Cloud API does, without the plumbing</h2>
      <div class='features__grid'>
        {features.map((feature, index) => (
          <a class:list={['feature', `tone-${feature.tone}`]} data-reveal href={url(feature.href)} style={`--delay: ${index * 0.06}s`}>
            <h3>{feature.title}</h3>
            <p>{feature.text}</p>
          </a>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 56px;
    align-items: center;
    padding-top: 72px;
    padding-bottom: 88px;
  }
  .hero__title { margin-top: 10px; font-size: clamp(36px, 5vw, 56px); line-height: 1.08; color: var(--ink-strong); }
  .hero__mark { position: relative; display: inline-block; }
  .hero__mark :global(.hero__underline) { position: absolute; left: 0; right: 0; bottom: -10px; width: 100%; height: 14px; }
  .hero__lead { margin-top: 22px; font-size: 19px; line-height: 1.6; color: var(--ink-light); max-width: 52ch; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }

  .hero__card {
    position: relative;
    padding: 28px 24px 22px;
    background: var(--surface);
    border: 1.5px solid var(--paper-border-strong);
    border-radius: var(--radius-blob);
    box-shadow: 6px 8px 0 color-mix(in srgb, var(--shadow-ink) 12%, transparent);
    transform: rotate(0.6deg);
  }
  .hero__card .tape { top: -12px; }
  .hero__card-label { font-size: 24px; color: var(--gold); margin: 4px 0 8px; }
  .hero__card-label + .code-block { margin-bottom: 14px; }
  .hero__card pre { font-size: 13.5px; }
  .install pre { color: var(--olive); font-weight: 700; }
  .hero__chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 6px; }
  .hero__chips a { text-decoration: none; color: var(--lavender-ink); background: var(--lavender-bg); border-color: var(--lavender-border); }

  .features { padding-bottom: 96px; }
  .features .section-title { margin-top: 6px; max-width: 24ch; }
  .features__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin-top: 36px; }
  .feature {
    display: block;
    padding: 22px 22px 24px;
    color: var(--ink);
    text-decoration: none;
    background: var(--tone-soft);
    border: 1.5px solid var(--tone-border);
    border-radius: var(--radius-card);
    box-shadow: 3px 4px 0 color-mix(in srgb, var(--shadow-ink) 8%, transparent);
    transition: transform 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out);
  }
  .feature:nth-child(even) { border-radius: var(--radius-card-alt); }
  .feature:hover { transform: translate(-2px, -3px) rotate(-0.4deg); box-shadow: 6px 7px 0 color-mix(in srgb, var(--shadow-ink) 12%, transparent); }
  .feature h3 { font-size: 22px; color: var(--tone-ink); }
  .feature p { margin-top: 8px; font-size: 15.5px; line-height: 1.6; color: var(--ink-light); }

  @media (max-width: 960px) {
    .hero { grid-template-columns: minmax(0, 1fr); padding-top: 40px; gap: 40px; }
    .hero__card { transform: none; }
    .features__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 620px) {
    .features__grid { grid-template-columns: 1fr; }
  }
</style>
